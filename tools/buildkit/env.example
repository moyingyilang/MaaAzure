# buildkit 配置模板：复制成 build.env 后按自己的环境改。
# 设计原则：**不含任何密钥**、**不含个人路径**，所有可变项都在这里。
#
# 本文件由 MaaAzure 维护，派生自 JMNeXt/tools/buildkit（MPL-2.0）。

PROJECT_DIR="$HOME/MaaAzure"
CHROOT_ROOT="$HOME/.local/share/tmoe-linux/containers/chroot/debian-bookworm_arm64"
CONTAINER_CARGO="/root/.cargo/bin/cargo"

# 需要挂进容器的宿主机目录
MOUNT_DIRS="$PROJECT_DIR"

# 目标矩阵（本机实测都能出包）：
#   aarch64-unknown-linux-gnu  本机开发，MAA-linux-aarch64，静态
#   x86_64-unknown-linux-gnu   Linux 用户，MAA-linux-x86_64，静态
#   x86_64-pc-windows-gnu      主目标，MAA-win-x86_64，dynamic
RUST_TARGET="x86_64-pc-windows-gnu"
MAA_SDK_DIR="$PROJECT_DIR/MAA-win-x86_64"
CARGO_FEATURES="maa-dynamic"
BIN_NAME="maazure-daemon"

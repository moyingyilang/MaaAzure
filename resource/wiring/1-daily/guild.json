{
  "_note": "结构草案：主界面→大舰队→领取报告→补给。作战/派遣未接（会消耗资源，等真机确认）。",
  "layer": "1-daily",
  "file": "guild/entry.json",
  "nodes": {
    "GuildStart": {
      "next": [
        "guild_start_game"
      ]
    },
    "guild_goto_page": {
      "use": "ui_main_goto_guild",
      "next": [
        "guild_page",
        "global_recover"
      ]
    },
    "guild_page": {
      "use": "guild_mission",
      "action": "DoNothing",
      "next": [
        "guild_claim_report",
        "guild_supply_once",
        "guild_done"
      ]
    },
    "guild_claim_report": {
      "use": "guild_report_claim",
      "next": [
        "guild_page",
        "guild_done"
      ]
    },
    "guild_supply_once": {
      "use": "guild_supply",
      "next": [
        "guild_page",
        "guild_done"
      ]
    },
    "guild_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "guild_start_game": {
      "desc": "GuildStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 0,
      "next": [
        "guild_login_announce_2",
        "guild_login_announce",
        "guild_login_game_update",
        "guild_login_enter",
        "guild_goto_page",
        "global_home"
      ],
      "timeout": 180000
    },
    "guild_login_announce_2": {
      "desc": "二级公告：关闭（guild 专用，点完回到 guild_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "guild_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "guild_login_announce": {
      "desc": "公告弹窗：关闭（guild 专用，点完回到 guild_start_game）",
      "use": "handler_login_announce",
      "next": [
        "guild_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "guild_login_game_update": {
      "desc": "游戏更新弹窗：关闭（guild 专用，点完回到 guild_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "guild_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "guild_login_enter": {
      "desc": "登录界面：点一下进入（guild 专用，点完回到 guild_start_game）",
      "use": "handler_login_check",
      "next": [
        "guild_start_game"
      ],
      "post_delay": 15000,
      "rate_limit": 20000,
      "max_hit": 1
    }
  }
}

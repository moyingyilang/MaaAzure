{
  "_note": "依据旧仓 page.py：page_main→page_campaign_menu→page_exercise（CAMPAIGN_MENU_GOTO_EXERCISE）。只读：到演习页即结束。",
  "layer": "1-daily",
  "file": "exercise/entry.json",
  "nodes": {
    "ExerciseStart": {
      "next": [
        "exercise_start_game"
      ]
    },
    "exercise_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "exercise_start_game": {
      "desc": "ExerciseStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 0,
      "next": [
        "exercise_login_announce_2",
        "exercise_login_announce",
        "exercise_login_game_update",
        "exercise_login_enter",
        "page_exercise",
        "nav_campaign_menu_to_exercise",
        "nav_main_to_campaign_menu"
      ],
      "timeout": 180000
    },
    "exercise_login_announce_2": {
      "desc": "二级公告：关闭（exercise 专用，点完回到 exercise_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "exercise_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "exercise_login_announce": {
      "desc": "公告弹窗：关闭（exercise 专用，点完回到 exercise_start_game）",
      "use": "handler_login_announce",
      "next": [
        "exercise_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "exercise_login_game_update": {
      "desc": "游戏更新弹窗：关闭（exercise 专用，点完回到 exercise_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "exercise_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "exercise_login_enter": {
      "desc": "登录界面：点一下进入（exercise 专用，点完回到 exercise_start_game）",
      "use": "handler_login_check",
      "next": [
        "exercise_start_game"
      ],
      "post_delay": 15000,
      "rate_limit": 20000,
      "max_hit": 1
    }
  }
}

{
  "_note": "结构草案：主界面→任务→一键领取。领取按钮的语义（一键/单个）未经真机验证。",
  "layer": "1-daily",
  "file": "reward/entry.json",
  "nodes": {
    "RewardStart": {
      "next": [
        "reward_start_game"
      ]
    },
    "reward_goto_page": {
      "use": "ui_main_goto_reward",
      "next": [
        "reward_page",
        "global_recover"
      ]
    },
    "reward_page": {
      "use": "reward_coin",
      "action": "DoNothing",
      "next": [
        "reward_collect_all",
        "reward_done"
      ]
    },
    "reward_collect_all": {
      "use": "reward_mission_multi",
      "next": [
        "reward_page",
        "reward_done"
      ]
    },
    "reward_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "reward_start_game": {
      "desc": "RewardStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 0,
      "next": [
        "reward_login_announce_2",
        "reward_login_announce",
        "reward_login_game_update",
        "reward_login_enter",
        "reward_goto_page",
        "global_home"
      ],
      "timeout": 180000
    },
    "reward_login_announce_2": {
      "desc": "二级公告：关闭（reward 专用，点完回到 reward_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "reward_start_game"
      ]
    },
    "reward_login_announce": {
      "desc": "公告弹窗：关闭（reward 专用，点完回到 reward_start_game）",
      "use": "handler_login_announce",
      "next": [
        "reward_start_game"
      ]
    },
    "reward_login_game_update": {
      "desc": "游戏更新弹窗：关闭（reward 专用，点完回到 reward_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "reward_start_game"
      ]
    },
    "reward_login_enter": {
      "desc": "登录界面：点一下进入（reward 专用，点完回到 reward_start_game）",
      "use": "handler_login_check",
      "next": [
        "reward_start_game"
      ]
    }
  }
}

{
  "layer": "1-daily",
  "file": "commission/entry.json",
  "nodes": {
    "CommissionStart": {
      "next": [
        "commission_start_game"
      ]
    },
    "commission_goto_reward": {
      "use": "ui_main_goto_reward",
      "next": [
        "commission_goto_commission",
        "commission_goto_reward",
        "global_recover"
      ]
    },
    "commission_goto_commission": {
      "use": "ui_reward_goto_commission",
      "next": [
        "commission_page",
        "global_recover"
      ]
    },
    "commission_page": {
      "use": "commission_daily",
      "action": "DoNothing",
      "next": [
        "commission_pick",
        "commission_done"
      ]
    },
    "commission_pick": {
      "recognition": "Custom",
      "custom_recognition": "CommissionPick",
      "action": "DoNothing",
      "next": [
        "commission_done",
        "global_home"
      ]
    },
    "commission_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "commission_start_game": {
      "desc": "CommissionStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 3000,
      "next": [
        "commission_wait_loaded"
      ]
    },
    "commission_wait_loaded": {
      "desc": "等游戏加载到主界面：长超时，识别主界面标志",
      "use": "ui_main_goto_campaign",
      "action": "DoNothing",
      "timeout": 180000,
      "next": [
        "commission_goto_reward",
        "global_home"
      ]
    }
  }
}

        "commission_done"
      ]
    },
    "commission_pick": {
      "recognition": "Custom",
      "custom_recognition": "CommissionPick",
      "action": "DoNothing",
      "next": [
        "commission_done",
        "global_home"
      ]
    },
    "commission_done": {
      "recognition": "DirectHit",
      "next": []

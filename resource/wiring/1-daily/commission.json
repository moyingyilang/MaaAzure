    "commission_login_announce_2": {
      "desc": "二级公告：关闭（commission 专用，点完回到 commission_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "commission_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "commission_login_announce": {
      "desc": "公告弹窗：关闭（commission 专用，点完回到 commission_start_game）",
      "use": "handler_login_announce",
      "next": [
        "commission_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "commission_login_game_update": {
      "desc": "游戏更新弹窗：关闭（commission 专用，点完回到 commission_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "commission_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "commission_login_enter": {
      "desc": "登录界面：点一下进入（commission 专用，点完回到 commission_start_game）",
      "use": "handler_login_check",
      "next": [
        "commission_start_game"
      ],
      "post_delay": 15000,
      "rate_limit": 20000,
      "max_hit": 1
    }

{
  "_note": "结构草案：主界面→宿舍→快速领取→补充食物。食物购买/家具购买的流程未接（要花钻石/币，等真机确认）。",
  "layer": "1-daily",
  "file": "dorm/entry.json",
  "nodes": {
    "DormStart": {
      "next": [
        "dorm_start_game"
      ]
    },
    "dorm_goto_menu": {
      "use": "ui_main_goto_dormmenu",
      "next": [
        "dorm_goto_dorm",
        "global_recover"
      ]
    },
    "dorm_goto_dorm": {
      "use": "ui_dormmenu_goto_dorm",
      "next": [
        "dorm_page",
        "global_recover"
      ]
    },
    "dorm_page": {
      "use": "dorm_manage",
      "action": "DoNothing",
      "next": [
        "dorm_collect",
        "dorm_feed",
        "dorm_done"
      ]
    },
    "dorm_collect": {
      "use": "dorm_quick_collect",
      "next": [
        "dorm_page",
        "dorm_done"
      ]
    },
    "dorm_feed": {
      "use": "dorm_feed_enter",
      "next": [
        "dorm_done"
      ]
    },
    "dorm_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "dorm_start_game": {
      "desc": "DormStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 0,
      "next": [
        "dorm_login_announce_2",
        "dorm_login_announce",
        "dorm_login_game_update",
        "dorm_login_enter",
        "dorm_goto_menu",
        "dorm_goto_dorm"
      ],
      "timeout": 180000
    },
    "dorm_login_announce_2": {
      "desc": "二级公告：关闭（dorm 专用，点完回到 dorm_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "dorm_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "dorm_login_announce": {
      "desc": "公告弹窗：关闭（dorm 专用，点完回到 dorm_start_game）",
      "use": "handler_login_announce",
      "next": [
        "dorm_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "dorm_login_game_update": {
      "desc": "游戏更新弹窗：关闭（dorm 专用，点完回到 dorm_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "dorm_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "dorm_login_enter": {
      "desc": "登录界面：点一下进入（dorm 专用，点完回到 dorm_start_game）",
      "use": "handler_login_check",
      "next": [
        "dorm_start_game"
      ],
      "post_delay": 15000,
      "rate_limit": 20000,
      "max_hit": 1
    }
  }
}

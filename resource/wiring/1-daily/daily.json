{
  "_note": "依据旧仓 module/ui/page.py：page_main --MAIN_GOTO_CAMPAIGN--> page_campaign_menu --CAMPAIGN_MENU_GOTO_DAILY--> page_daily。只读：到每日页即结束。",
  "layer": "1-daily",
  "file": "daily/entry.json",
  "nodes": {
    "DailyStart": {
      "next": [
        "daily_start_game"
      ]
    },
    "daily_done": {
      "recognition": "DirectHit",
      "next": []
    },
    "daily_start_game": {
      "desc": "DailyStart 之前先把游戏拉到虚拟屏（MaaEnd 的 StartApp 写法）",
      "recognition": "DirectHit",
      "action": {
        "type": "StartApp",
        "param": {
          "package": "com.bilibili.azurlane/com.manjuu.azurlane.MainActivity"
        }
      },
      "pre_delay": 0,
      "post_delay": 0,
      "next": [
        "daily_login_announce_2",
        "daily_login_announce",
        "daily_login_game_update",
        "daily_login_enter",
        "page_daily",
        "nav_campaign_menu_to_daily",
        "nav_main_to_campaign_menu"
      ],
      "timeout": 180000
    },
    "daily_login_announce_2": {
      "desc": "二级公告：关闭（daily 专用，点完回到 daily_start_game）",
      "use": "handler_login_announce_2",
      "next": [
        "daily_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "daily_login_announce": {
      "desc": "公告弹窗：关闭（daily 专用，点完回到 daily_start_game）",
      "use": "handler_login_announce",
      "next": [
        "daily_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "daily_login_game_update": {
      "desc": "游戏更新弹窗：关闭（daily 专用，点完回到 daily_start_game）",
      "use": "handler_login_game_update",
      "next": [
        "daily_start_game"
      ],
      "post_delay": 4000,
      "rate_limit": 6000,
      "max_hit": 2
    },
    "daily_login_enter": {
      "desc": "登录界面：点一下进入（daily 专用，点完回到 daily_start_game）",
      "use": "handler_login_check",
      "next": [
        "daily_start_game"
      ],
      "post_delay": 15000,
      "rate_limit": 20000,
      "max_hit": 1
    }
  }
}

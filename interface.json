{
  "interface_version": 2,
  "name": "MaaAzure",
  "label": "MaaAzure · 碧蓝航线",
  "version": "0.1.17",
  "github": "https://github.com/moyingyilang/MaaAzure",
  "license": "AGPL-3.0-only",
  "contact": "- GitHub Issues：[提交问题](https://github.com/moyingyilang/MaaAzure/issues)\n- 仓库地址：<https://github.com/moyingyilang/MaaAzure>",
  "controller": [
    {
      "name": "ADB",
      "label": "ADB 模拟器",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "cn",
      "label": "国服",
      "path": [
        "./resource/common",
        "./resource/cn"
      ]
    },
    {
      "name": "en",
      "label": "美服",
      "path": [
        "./resource/common",
        "./resource/en"
      ]
    },
    {
      "name": "jp",
      "label": "日服",
      "path": [
        "./resource/common",
        "./resource/jp"
      ]
    },
    {
      "name": "tw",
      "label": "台服",
      "path": [
        "./resource/common",
        "./resource/tw"
      ]
    }
  ],
  "preset": [
    {
      "name": "默认",
      "label": "默认",
      "description": "已接线的日常任务：委托、战术学院、任务奖励、宿舍、大舰队、演习、指挥喵、科研、每日、建造（只读）。",
      "task": [
        {
          "name": "Commission",
          "enabled": true
        },
        {
          "name": "Daily",
          "enabled": true
        },
        {
          "name": "Dorm",
          "enabled": true
        },
        {
          "name": "Exercise",
          "enabled": true
        },
        {
          "name": "Gacha",
          "enabled": true
        },
        {
          "name": "Guild",
          "enabled": true
        },
        {
          "name": "Meowfficer",
          "enabled": true
        },
        {
          "name": "Research",
          "enabled": true
        },
        {
          "name": "Reward",
          "enabled": true
        },
        {
          "name": "Tactical",
          "enabled": true
        }
      ]
    }
  ],
  "import": [
    "interface.d/groups.json",
    "interface.d/options.json",
    "interface.d/tasks.json"
  ],
  "about": "**MaaAzure** 是基于 MaaFramework 的碧蓝航线自动化工具。\n\n- 运行时零 Python 依赖：识别与动作走 Pipeline，业务逻辑用 Rust\n- 支持 CN / EN / JP / TW 四个服务器\n- 采用 AGPL-3.0 许可证\n\n> 本项目仅供学习与个人使用，请遵守游戏用户协议。"
}
